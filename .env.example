# WhatsApp / Meta settings
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Paystack
PAYSTACK_SECRET=

# OpenAI API key (optional — disables image generation if empty)
OPENAI_API_KEY=

# Webhook verification token (change this from the default)
VERIFY_TOKEN=safari_ug_2026

# Google Sheets credentials
# Option A (recommended): mount a credentials.json file into the container at /app/credentials.json
# Option B: set GOOGLE_CREDENTIALS_JSON to the base64-encoded JSON contents of credentials.json
# Example: export GOOGLE_CREDENTIALS_JSON=$(base64 -w0 credentials.json)
GOOGLE_CREDENTIALS_PATH=/app/credentials.json
GOOGLE_CREDENTIALS_JSON=

# Flask port (container)
PORT=5000
