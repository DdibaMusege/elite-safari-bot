# WhatsApp / Meta settings
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Paystack
PAYSTACK_SECRET=

# OpenAI API key (optional — disables image generation if empty)
OPENAI_API_KEY=

# Webhook verification token (change this from the default)
VERIFY_TOKEN=safari_ug_2026

# Google Sheets credentials
# By default the app looks for a credentials.json file in the working directory.
# You can mount the file into the container or modify the app to read GOOGLE_CREDENTIALS_JSON (base64).
GOOGLE_CREDENTIALS_PATH=credentials.json

# Flask port (container)
PORT=5000
